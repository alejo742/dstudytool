# ---- Supabase (server) ----
# Project URL (same as the one the web app uses)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Publishable key (used for storage reads if needed). Supabase's new-style
# `sb_publishable_…` replaces the legacy `anon` key.
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Service role key — NEVER ship to the browser. Used to bypass RLS on
# server-side operations (uploads/extraction/generation writes).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT secret from the Supabase dashboard (Settings → API → JWT Settings)
# Required to verify tokens coming from the web app.
SUPABASE_JWT_SECRET="your-jwt-secret"

# ---- CORS / Web origin ----
# Comma-separated list of allowed origins
WEB_ORIGINS="http://localhost:5173,http://localhost:3000"

# ---- Encryption for user-supplied API keys ----
# 32-byte URL-safe base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=""

# ---- Dartmouth AI defaults ----
# Default model name used for generation when nothing more specific is set
DARTMOUTH_DEFAULT_MODEL="openai.gpt-4.1-mini-2025-04-14"

# Domain restriction (matches web)
ALLOWED_EMAIL_DOMAIN="dartmouth.edu"

# ---- Local file storage root ----
# Where uploaded files are kept until Supabase Storage is wired up.
LOCAL_STORAGE_ROOT="./.data/uploads"
