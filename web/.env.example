# ---- Supabase (public, safe to ship to the browser) ----
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# ---- API ----
# URL of the FastAPI backend
VITE_API_URL="http://localhost:8000"

# ---- Site ----
# Fully qualified origin of this web app (used to build OAuth redirect URLs)
VITE_SITE_URL="http://localhost:5173"

# ---- Access restriction ----
# Only Google accounts under this domain can sign in
VITE_ALLOWED_EMAIL_DOMAIN="dartmouth.edu"
